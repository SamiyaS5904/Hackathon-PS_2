# Copy this file to .env and fill in the values. Never commit .env.

# Claude API key: used ONLY by engine/agent.py. Leave empty to run everything on the fallback rules.
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# The bot's username without @ (public, not a secret): used to build tester links t.me/<username>?start=<token>
TELEGRAM_BOT_USERNAME=

# Model for the agent
CLAUDE_MODEL=claude-sonnet-5-5

# Hard ceiling for AI decisions per day. The dashboard Day Plan can set a lower number, never higher.
MAX_AGENT_RUNS_PER_DAY=50

# SQLite database file
DB_PATH=data/offerpilot.db

# Agent tuning (optional)
# Seconds per AI call before giving up (then the fallback decides). Real Opus calls took up to ~15s.
AGENT_TIMEOUT_SECONDS=30
# How hard the model thinks: low | medium | high | xhigh | max (higher = better reasoning, more tokens)
AGENT_EFFORT=medium

# Freeze the clock for demos/tests (UTC). Leave empty to use the real time.
OFFERPILOT_NOW=
